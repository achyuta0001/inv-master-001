    {
      "id": "R0rKcWWlEHPC6rlL",
      "type": "text",
      "x": 80,
      "y": 72,
      "width": 1400,
      "height": 48,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "text": "LEGEND    solid arrow = DB foreign key  \u00b7  red dashed = soft ref (app-level, NO db constraint)\nPK primary key \u00b7 FK foreign key \u00b7 SFK soft/logical FK \u00b7 U unique \u00b7 NN not null \u00b7 CASCADE on delete\nall tables carry created_at / updated_at / deleted_at (soft delete)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LEGEND    solid arrow = DB foreign key  \u00b7  red dashed = soft ref (app-level, NO db constraint)\nPK primary key \u00b7 FK foreign key \u00b7 SFK soft/logical FK \u00b7 U unique \u00b7 NN not null \u00b7 CASCADE on delete\nall tables carry created_at / updated_at / deleted_at (soft delete)",
      "lineHeight": 1.35,
      "baseline": 10,
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 936055874,
      "version": 1,
      "versionNonce": 1363189795,
